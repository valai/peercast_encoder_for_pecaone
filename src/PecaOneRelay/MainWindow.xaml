<Window x:Class="PecaOneRelay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ぺかわん Windows リレー" Height="660" Width="710" MinHeight="580" MinWidth="620"
        Background="#F4F7FA" FontFamily="Yu Gothic UI" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="ぺかわん Windows リレー" FontSize="23" FontWeight="Bold" Foreground="#16263B"/>
            <TextBlock Text="PeerCastStation でリレーし、スマホへ3画質のHLSを送ります。" Margin="0,4,0,20" Foreground="#4A5C70"/>
            <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="接続状態" FontWeight="Bold" FontSize="17"/>
                    <TextBlock x:Name="VpnStatus" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PeerStatus" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SessionStatus" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SessionError" Foreground="#B42318" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="StopButton" Content="現在の視聴を終了" Padding="12,7" Click="Stop_Click"/>
                        <Button Content="状態を更新" Padding="12,7" Margin="8,0,0,0" Click="Refresh_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="スマホのペアリング" FontWeight="Bold" FontSize="17"/>
                    <TextBlock x:Name="PairStatus" Margin="0,8,0,0"/>
                    <TextBlock Text="スマホの連携機能が実装されたら、このQRを読み取ってください。コードは5分間有効です。" TextWrapping="Wrap" Foreground="#4A5C70" Margin="0,7,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="ペアリングQRを作成" Padding="12,7" Click="Pair_Click"/>
                        <Button Content="登録端末を解除" Padding="12,7" Margin="8,0,0,0" Click="Revoke_Click"/>
                    </StackPanel>
                    <Image x:Name="PairQr" Width="240" Height="240" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    <TextBlock x:Name="PairExpires" Foreground="#4A5C70" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="ローカル設定" FontWeight="Bold" FontSize="17"/>
                    <TextBlock Text="PeerCastStation のローカルURL" Margin="0,10,0,3"/>
                    <TextBox x:Name="PeerUrl" Padding="7"/>
                    <TextBlock Text="VPN待受ポート" Margin="0,10,0,3"/>
                    <TextBox x:Name="ListenPort" Width="100" HorizontalAlignment="Left" Padding="7"/>
                    <Button Content="設定を保存" Padding="12,7" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Save_Click"/>
                    <TextBlock x:Name="SettingsMessage" Foreground="#4A5C70" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="画面を閉じてもトレイで待機します。終了はトレイメニューから操作してください。" Margin="0,14,0,0" Foreground="#4A5C70"/>
        </StackPanel>
    </ScrollViewer>
</Window>
